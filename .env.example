# Локальный OpenAI-совместимый сервер (LM Studio).
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio
LOCAL_MODEL=google/gemma-4-26b-a4b-qat # в LmStudio отключить галочку thinking,чтобы не превысить max_tokens из-за размышлений модели
LOCAL_REASONING_EFFORT=

# Параметры генерации.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=32768
LLM_TIMEOUT_SECONDS=600

# Модель эмбеддингов из HuggingFace.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Папки проекта.
DOCUMENTS_DIR=documents
PARSED_DIR=parsed
CHROMA_DIR=chroma
CHROMA_COLLECTION=documents

# Нарезка и поиск.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
