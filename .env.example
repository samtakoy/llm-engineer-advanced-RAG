# Локальный OpenAI-совместимый сервер (LM Studio).
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio
LOCAL_MODEL=google/gemma-4-26b-a4b-qat # в LmStudio отключить галочку thinking,чтобы не превысить max_tokens из-за размышлений модели
LOCAL_REASONING_EFFORT=
# Модель-судья для прогона контрольных вопросов (src/eval).
# Пусто — судит та же модель, что отвечает.
JUDGE_MODEL=google/gemma-4-26b-a4b-qat

# Параметры генерации.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16384
LLM_CONTEXT_WINDOW=32768
LLM_TIMEOUT_SECONDS=600

# Модель эмбеддингов из HuggingFace.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Cross-encoder, переставляющий найденные фрагменты по близости к вопросу.
# Пусто — порядок остаётся за поиском. Скачивается при первом запуске.
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Папки проекта.
DOCUMENTS_DIR=documents
PARSED_DIR=parsed
CHROMA_DIR=chroma
CHROMA_COLLECTION=documents

# Нарезка и поиск. Чанк должен помещаться в окно EMBEDDING_MODEL: у e5-small это
# 512 токенов, у bge-m3 — 8192. Не помещается — запуск падает, а не молча теряет хвост.
CHUNK_SIZE=480
CHUNK_OVERLAP=200
# Сколько фрагментов уходит модели и сколько поиск приносит реранкеру до отбора.
TOP_K=5
CANDIDATE_TOP_K=20
# true — к векторному поиску добавляется лексический BM25, выдачи объединяются.
HYBRID_SEARCH=false
# Разнообразие выдачи: 1.0 — только близость к вопросу, 0.0 — только непохожесть
# фрагментов друг на друга. Пусто — разнообразие не учитывается.
MMR_THRESHOLD=
